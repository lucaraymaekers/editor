@table(Name)
PanelTypes:
{
 { Empty,}
 { Sheet, }
 { Roll, }
 { Controls, }
 { Piece, }
 { Debug, }
}

@data_enum("panel_kind")
PanelKind:
{
 @expand(PanelTypes)
  ```PanelKind_$(Name),
 ```;
 `PanelKind_Count`;
}



@data_table("str8")
PanelTypeStrings: 
{
 @expand(PanelTypes) @strings
  `{$(Name)},`;
}
