@table(Type, Name, Default)
LayoutStacks:
{
 { v4        BackgroundColor `Color_Background`   }
 { v4        TextColor       `Color_ButtonText`   }
 { v4        BorderColor     `Color_ButtonBorder` }
 { f32       BorderThickness `1.f`                }
 { f32       Softness        `0.f`                } 
 { v4        CornerRadii     `V4F32(0.f)`         }
 { axis2     LayoutAxis      `Axis2_X`            }
 { ui_size   SemanticWidth   `UI_SizeFull()`      }
 { ui_size   SemanticHeight  `UI_SizeFull()`      }
 { f32       HeightPx        `HeightPx`           }
 { font_kind FontKind        `FontKind_Text`      }
 { v4        Clip            `Root->Rec`          }
 { b32       Debug            `false`             }
}

@table(Type)
LayoutTypes:
{
 { b32       }
 { f32       }
 { v4        }
 { axis2     }
 { ui_size   }
 { font_kind }
}

@data_enum("ui_box_flag")
UI_FlagEnum:
{
 ```UI_BoxFlag_None = (0 << 0),
 ```
  @expand(UI_Flags)
  ```UI_BoxFlag_$(Name) = (1 << $(_Idx)),
 ```;
}

@data
LayoutStacksTypes:
{
 `#define UI_LayoutStacks `;
 @expand(LayoutTypes)
  `typedef struct $(Type)_stack_node $(Type)_stack_node; struct $(Type)_stack_node { $(Type)_stack_node *Prev; $(Type) Value; }; `;
}

@data
LayoutProperties:
{
 `#define UI_StateStacks `;
 @expand(LayoutStacks)
  `$(Type)_stack_node *$(Name)Top; `;
}

@data
LayoutFunctions:
{
 `#define UI_StackFunctions `;
 @expand(LayoutStacks)
  ```\
  internal void UI_Push$(Name)($(Type) $(Name)) { UI_StackPush($(Type), $(Name)); } \
 internal void UI_Pop$(Name)(void) { UI_StackPop($(Name)); } ```;
 @expand(LayoutStacks)
  ```
#define UI_$(Name)(Value) DeferLoop(UI_Push$(Name)(Value), UI_Pop$(Name)())```
}


