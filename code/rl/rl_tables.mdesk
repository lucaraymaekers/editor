//~ Colors
@table(Name, Value) 
Colors:
{
 { Frost0   0xff8fbcbb }
 { Frost1   0xff88c0d0 }
 { Frost2   0xff81a1c1 }
 { Frost3   0xff5e81ac }
 { Snow0    0xffeceff4 }
 { Snow1    0xffe5e9f0 }
 { Snow2    0xffd8dee9 }
 { Night0   0xff4c566a }
 { Night1   0xff434c5e }
 { Night2   0xff3b4252 }
 { Night3   0xff2e3440 }
 { Red      0xffbf616a }
 { Orange   0xffd08770 }
 { Yellow   0xffebcb8b }
 { Green    0xffa3be8c }
 { Magenta  0xffb48ead }
 { Cyan     0xff81a1c1 }
 { Blue     0xff5e81ac }
 { Black    0xff000000 }
}

@data
ColorsU32:
{
 @expand(Colors)
  ```u32 ColorU32_$(Name) = $(Value);
 ```;
}

@data
ColorsV4:
{
 @expand(Colors)
  ```v4 Color_$(Name) = {U32ToV4Arg($(Value))};
 ```;
}

//~ Notes and keys
@table(Colemak, Qwerty, Name, String)
Notes:
{
 { A A  C  "C"  }
 { W W  Cs "C#" }
 { R S  D  "D"  }
 { F E  Ds "D#" }
 { S D  E  "E"  }
 { T F  F  "F"  }
 { G T  Fs "F#" }
 { D G  G  "G"  }
 { J Y  Gs "G#" }
 { H H  A  "A"  }
 { L U  As "A#" }
 { N J  B  "B"  }
}

@data
MIDIInputKeys:
{
 `#define APP_MIDIInputKeys `;
 @expand(Notes)
  `app_button_state Key$(Qwerty); `
}


@data_enum("note_pitch")
NotePitches:
{
 @expand(Notes)
  `Note_$(Name),`;
 `Note_Count`;
}


@data_strings(Notes String) 
NotePitchStrings: ()

@data_table(`uint`)
Win32ColemakMIDIKeySymbols:
{
 @expand(Notes) `'$(Colemak)',`
}

@data_table(`uint`)
Win32QwertyMIDIKeySymbols:
{
 @expand(Notes) `'$(Qwerty)',`
}

@to_lower
@data
LinuxColemakMIDIKeySymbols:
{
 `#define LinuxColemakMIDIKeySymbolsDef `
 @expand(Notes) `XK_$(Colemak),`
}

@to_lower
@data
LinuxQwertyMIDIKeySymbols:
{
 `#define LinuxQwertyMIDIKeySymbolsDef `
 @expand(Notes) `XK_$(Qwerty),`
}