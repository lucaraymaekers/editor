//~ Colors
@table(Name, Value) 
Colors:
{
 { Frost0   0xff8fbcbb }
 { Frost1   0xff88c0d0 }
 { Frost2   0xff81a1c1 }
 { Frost3   0xff5e81ac }
 { Snow0    0xffeceff4 }
 { Snow1    0xffe5e9f0 }
 { Snow2    0xffd8dee9 }
 { Night0   0xff4c566a }
 { Night1   0xff434c5e }
 { Night2   0xff3b4252 }
 { Night3   0xff2e3440 }
 { Red      0xffbf616a }
 { Orange   0xffd08770 }
 { Yellow   0xffebcb8b }
 { Green    0xffa3be8c }
 { Magenta  0xffb48ead }
 { Cyan     0xff81a1c1 }
 { Blue     0xff5e81ac }
 { Black    0xff000000 }
}

@data
ColorsU32:
{
 @expand(Colors)
  ```u32 ColorU32_$(Name) = $(Value);
 ```;
}

@data
ColorsV4:
{
 @expand(Colors)
  ```v4 Color_$(Name) = {U32ToV4Arg($(Value))};
 ```;
}

//~ Notes and keys
@table(Colemak, Qwerty, Name, Base, String, Step, White)
NotesTable:
{
 { A A  C  C "C"  0 true  }
 { W W  Cs C "C#" 0 false }
 { R S  D  D "D"  1 true  }
 { F E  Ds D "D#" 1 false }
 { S D  E  E "E"  2 true  }
 { T F  F  F "F"  3 true  }
 { G T  Fs F "F#" 3 false }
 { D G  G  G "G"  4 true  }
 { J Y  Gs G "G#" 4 false }
 { H H  A  A "A"  5 true  }
 { L U  As A "A#" 5 false }
 { N J  B  B "B"  6 true  }
}

@table(Name)
NotesBase:
{
 { C }
 { D }
 { E }
 { F }
 { G }
 { A }
 { B }
}

@data_enum("base_note")
BaseNotePitches:
{
 @expand(NotesBase)
  ```BaseNote_$(Name),
 ```;
 `BaseNote_Count`;
}

@data_enum("note_pitch")
NotePitches:
{
 @expand(NotesTable)
  ```Note_$(Name),
 ```;
 `Note_Count`;
}

@data_table("s32")
NoteStepFromPitch:
{
 @expand(NotesTable)
  `$(Step),`;
}

@data_table("b32")
NoteIsWhite:
{
 @expand(NotesTable)
  `$(White),`
}

@data
MIDIInputKeys:
{
 `#define APP_MIDIInputKeys `;
 @expand(NotesTable)
  `app_button_state Key$(Qwerty); `
}

@data_table("str8")
NotePitchStrings: 
{
 @expand(NotesTable) @strings
  `{$(String)},`;
}

@data
Win32ColemakMIDIKeySymbols:
{
 `#define Win32ColemakMIDIKeySymbolsDef `
 @expand(NotesTable) `'$(Colemak)', `
}

@data
Win32QwertyMIDIKeySymbols:
{
 `#define Win32QwertyMIDIKeySymbolsDef `
 @expand(NotesTable) `'$(Qwerty)', `
}

@to_lower
@data
LinuxColemakMIDIKeySymbols:
{
 `#define LinuxColemakMIDIKeySymbolsDef `
 @expand(NotesTable) `XK_$(Colemak),`
}

@to_lower
@data
LinuxQwertyMIDIKeySymbols:
{
 `#define LinuxQwertyMIDIKeySymbolsDef `
 @expand(NotesTable) `XK_$(Qwerty),`
}